/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/tandemrepeat Nextflow config file for running full tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run nf-core/tandemrepeat -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full test dataset to check pipeline function'

    // Limit resources so that this can run on GitHub Actions
    max_cpus   = 4
    max_memory = '16.GB'
    max_time   = '12.h'

    // Input data
    input  = 'https://raw.githubusercontent.com/nf-core/test-datasets/tandemrepeat/samplesheet/full_test.csv'
    fasta  = 'https://raw.githubusercontent.com/nf-core/test-datasets/tandemrepeat/reference/genome.fa'

    // Test with all tools
    tools  = 'trf,ultra,vampire'
}
